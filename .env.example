# Copy to .env for local development. Production values live only in Render's environment.
# The app role must NOT own tables, be superuser, or have BYPASSRLS (INV-1.4).
DATABASE_URL=postgres://mh_app:mh_app_dev@localhost:5432/mentors_hub
# Used only by migrations and the worker's schema setup: the owner role.
MIGRATION_DATABASE_URL=postgres://mh_owner:mh_owner_dev@localhost:5432/mentors_hub
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-at-least-32-random-characters
MAIL_FROM="Mentorship Hub <no-reply@example.test>"
SMTP_URL=smtp://localhost:1025
DEFAULT_TIME_ZONE=Asia/Baku
